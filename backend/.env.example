JWT_SECRET="change-me"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# When using the mongodb container from docker-compose:
MONGODB_URI=mongodb://mongodb:27017/thakare-ecom
# When using MongoDB Atlas instead, use your Atlas connection string:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-url>/thakare-ecom

CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_SECRET_KEY=your_cloudinary_secret_key
CLOUDINARY_NAME=your_cloudinary_cloud_name

STRIPE_SECRET_KEY=your_stripe_secret_key

RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_KEY_ID=your_razorpay_key_id
